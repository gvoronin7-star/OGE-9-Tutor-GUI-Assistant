# ProxyAPI настройки (GPT-4o-mini)
PROXY_API_URL=https://proxyapi.ru/openai
PROXY_API_KEY=your_proxy_api_key_here

# Redis настройки
REDIS_HOST=redis
REDIS_PORT=6379

# Уровень логирования
LOG_LEVEL=INFO

# Настройки приложения
APP_NAME=OGE_Tutor
APP_VERSION=2.3.0

# RAG: включить базу ФИПИ (197 чанков) вместо пустого локального индекса
# USE_EXISTING_INDEX=false

# При USE_EXISTING_INDEX=true поиск эмбеддит запрос через OpenAI
# text-embedding-3-small (тем же способом, которым построен индекс) —
# без этих переменных поиск не найдёт совпадений даже с включённым флагом
# OPENAI_API_KEY=sk-...          # если не задан, используется PROXY_API_KEY
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
